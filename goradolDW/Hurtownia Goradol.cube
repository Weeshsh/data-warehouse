      <Goal>(ParallelPeriod([ID Data].[Data hierarchia].[Miesiac],1,[ID Data].[Data hierarchia].CurrentMember), KPIValue("Cel Biznesowy 2")) * 0.915</Goal>
      <Status>IIF(KPIValue("Cel Biznesowy 2") &lt;= KPIGoal("Cel Biznesowy 2"), 1, 0 )</Status>
      <Trend>IIF(
    KPIValue("Cel Biznesowy 2") &gt;= (
        (ParallelPeriod([ID Data].[Data hierarchia].[Miesiac], 1, [ID Data].[Data hierarchia].CurrentMember),
        KPIValue("Cel Biznesowy 2"))
    ),
    1,
    -1
)</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
