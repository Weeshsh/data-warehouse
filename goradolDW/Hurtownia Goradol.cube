  <Source dwd:design-time-name="c346e204-d5ef-41a7-8bb0-ae7d9f563075">
    <DataSourceViewID>Hurtownia Goradol</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="58c9cc21-d849-49e4-83e3-859f1c6ecf0d">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text> /*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;    
CREATE MEMBER CURRENTCUBE.[Measures].IleDniOdPrzegladuAVG
 AS IIF([Measures].[Awaria Wyciagu Count]=0,0,[Measures].[Ile Dni Od Przegladu]/[Measures].[Awaria Wyciagu Count]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Awaria Wyciagu';   
CREATE MEMBER CURRENTCUBE.[Measures].CzyBylPrzystoj
 AS IIF(
       [Measures].[Dlugosc Przystojow] &gt; 0,
        1,
        0
    ), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Przejazd Narciarza';    CREATE MEMBER CURRENTCUBE.[Measures].SredniaDlugoscKolejki
 AS IIF( [Measures].[Przejazd Narciarza Count] = 0, 0, [Measures].[Dlugosc Kolejki] / [Measures].[Czy Byla Kolejka] ), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Przejazd Narciarza';   
CREATE MEMBER CURRENTCUBE.[Measures].KOSZT_UTRZYMANIA
 AS [Measures].[Koszt] + [Measures].[Koszt - Przeglad Wyciagu], 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].jeden
 AS 1, 
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].kosztNaPrzejazd
 AS IIF([Measures].[Przejazd Narciarza Count] = 0,
        NULL,
        ([Measures].[KOSZT_UTRZYMANIA]) / [Measures].[Przejazd Narciarza Count]
    ), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].najczesciejtypawarii
 AS GENERATE(
    TOPCOUNT(
        [Typ Awarii].[Nazwa].[Nazwa].MEMBERS,
        1,
        [Measures].[Awaria Wyciagu Count]
    ),
    [Typ Awarii].[Nazwa].CURRENTMEMBER.MEMBER_CAPTION
), 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="8b30fb02-c63c-4359-b42e-6cf976e37d3a">
      <ID>KPI</ID>
      <Name>Cel Biznesowy 1</Name>
      <Value>[Measures].[Koszt] + [Measures].[Koszt - Przeglad Wyciagu]</Value>
      <Goal>(ParallelPeriod([ID Data].[Data hierarchia].[Miesiac],1,[ID Data].[Data hierarchia].CurrentMember), KPIValue("Cel Biznesowy 1")) * 0.95</Goal>
      <Status>IIF(KPIValue("Cel Biznesowy 1") &lt;= KPIGoal("Cel Biznesowy 1"), 1, 0 )</Status>
      <Trend>IIF(
    KPIValue("Cel Biznesowy 1") &gt;= (
        (ParallelPeriod([ID Data].[Data hierarchia].[Miesiac], 1, [ID Data].[Data hierarchia].CurrentMember),
        KPIValue("Cel Biznesowy 1"))
    ),
    1,
    -1
)</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="42876c2c-3572-4218-8cc5-6f7dda24c67d">
